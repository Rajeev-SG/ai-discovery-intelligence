# Copy to .env for local runs. All values are optional (sensible defaults exist).
# Never commit real credentials.
AI_DISCOVERY_DATABASE_URL=postgresql+psycopg://ai_discovery:ai_discovery@127.0.0.1:55432/ai_discovery
AI_DISCOVERY_SNAPSHOT_DIR=var/snapshots
AI_DISCOVERY_PER_HOST_DELAY_SECONDS=2.0
AI_DISCOVERY_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
