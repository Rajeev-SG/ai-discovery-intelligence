[Unit]
Description=Weekly ai-discovery-intelligence acquisition run

[Timer]
# Weekly, Saturday, so the Sunday 02:00 UTC field-guide writer (adi-writer.timer)
# works from fresh evidence. Offset from the ad-platform Monday run. Unchanged
# sources are skipped without a model call. On demand: `sudo intel-refresh adi`.
OnCalendar=Sat *-*-* 06:10:00 UTC
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
